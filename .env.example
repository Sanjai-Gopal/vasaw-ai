# ============================================================
# VASAW AI — Environment Configuration Template (.env.example)
# ============================================================
# Copy this file to .env.local and populate the values.
# NEVER commit .env.local with real secrets into git.

# ------------------------------------------------------------
# 0. Application Integration & Safety Modes
# ------------------------------------------------------------
# APP_INTEGRATION_MODE: "mock" (default) or "live"
# In "mock", external network calls are simulated safely.
# In "live", real Apify, Vercel, Supabase, Google Sheets, and WhatsApp are invoked.
APP_INTEGRATION_MODE=mock

# OUTREACH_MODE: "disabled" (default), "mock", or "live"
# In "disabled", messages are generated and saved in DB but NEVER dispatched.
# In "mock", messages are simulated.
# In "live", messages are sent to real WhatsApp phone numbers via Meta API.
OUTREACH_MODE=disabled

# Batch sizing for campaign execution runs (default: 10)
CAMPAIGN_BATCH_SIZE=10

# ------------------------------------------------------------
# 1. Supabase Database & Auth (Required for persistent storage)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------
# 2. Agent 1: Scraping (Apify)
# ------------------------------------------------------------
APIFY_API_TOKEN=your-apify-token-here
APIFY_ACTOR_ID=nwua9Gu5YrADL7ZDj

# ------------------------------------------------------------
# 3. Agent 2 & Agent 4: AI Providers (NVIDIA, Groq, Gemini, Cloudflare)
# ------------------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_GENERAL_MODEL=nvidia/nemotron-mini-4b-instruct
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_CODING_MODEL=nvidia/nemotron-mini-4b-instruct

GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ------------------------------------------------------------
# 4. Agent 5: Deployment (Vercel & GitHub)
# ------------------------------------------------------------
VERCEL_TOKEN=your-vercel-token-here
VERCEL_TEAM_ID=your-vercel-team-id-optional
VERCEL_PROJECT_ID=your-vercel-project-id-optional
GITHUB_TOKEN=your-github-token-optional

# ------------------------------------------------------------
# 5. Agent 6: WhatsApp (Meta Cloud API)
# ------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac-sha256

# ------------------------------------------------------------
# 6. Google Sheets (Operational Sync & Export)
# ------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id

# ------------------------------------------------------------
# 7. Global Operational Flags
# ------------------------------------------------------------
DRY_RUN=false
PORT=3000
